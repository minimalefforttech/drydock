{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://drydock.local/schemas/extension-manifest.schema.json",
  "title": "Drydock Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "version",
    "kind",
    "extensionPoints",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "drydock.extension.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]+$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "task-provider",
        "agent-provider",
        "runtime-adapter",
        "panel-provider",
        "memory-provider",
        "test-provider",
        "multi-provider"
      ]
    },
    "extensionPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "id",
          "version",
          "capabilities"
        ],
        "properties": {
          "type": {
            "enum": [
              "task-provider",
              "agent-provider",
              "runtime-adapter",
              "panel-provider",
              "memory-provider",
              "test-provider",
              "diff-provider",
              "plan-provider"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "capabilities": {
            "type": "object"
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "secretRefRequired"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "api-token",
            "oauth",
            "oauth-or-api-token",
            "provider-secret-ref"
          ]
        },
        "secretRefRequired": {
          "type": "boolean"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "api": {
      "type": "object"
    },
    "capabilities": {
      "type": "object"
    },
    "canonicalMappings": {
      "type": "object"
    }
  }
}
