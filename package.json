{
  "name": "drydock-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Security-first VS Code extension for running coding agents in disposable isolated runtimes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/minimalefforttech/drydock.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:prevalidate": "tsc -p tools/prevalidate/tsconfig.json",
    "prevalidate": "npm run build:prevalidate --silent && node tools/prevalidate/dist/index.js",
    "prevalidate:strict": "npm run build:prevalidate --silent && node tools/prevalidate/dist/index.js --strict",
    "package:vsix": "node tools/package-vsix.mjs",
    "test": "npm run build --silent && node --test",
    "smoke": "npm run build --silent && node tools/runtime-smoke/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "mermaid": "^11.16.0",
    "typescript": "^5.8.0"
  }
}
